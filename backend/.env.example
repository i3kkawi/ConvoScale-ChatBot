# Copy this file to backend/.env and fill in real values. Never commit .env.

# PostgreSQL — must match docker-compose.yml credentials
DATABASE_URL="postgresql://convoscale:convoscale_local_pw@localhost:5432/convoscale?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Backend server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1h"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
MESSAGE_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=20

# CORS — must match the origin the frontend actually runs on
FRONTEND_ORIGIN="http://localhost:5173"

# Set to "true" only when deployed behind a reverse proxy/load balancer (Day 6)
TRUST_PROXY=false
